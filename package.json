{
  "name": "hang2048",
  "version": "2.0.0",
  "description": "夯048（Hang2048）：拉完了 → NPC → 人上人 → 顶级 → 夯 合成链桌面游戏",
  "main": "main.js",
  "author": "HYTools",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron tools/smoke.cjs",
    "icon": "electron tools/make-icon.cjs",
    "dist": "electron-builder --win",
    "dist:cn": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hytools.hang2048",
    "productName": "Hang2048",
    "copyright": "Copyright © 2025 HYTools",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "夯048",
      "artifactName": "Hang2048-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Hang2048-Portable-${version}.${ext}"
    }
  }
}
